# MCMA-OpenMemory example environment file
#
# COPY ONLY THE VARIABLE NAMES YOU NEED.
# Generate real secret values on the target system or inject them from a
# secret manager. Never commit a populated production environment file.

# Core crypto / compatibility runtime
# MCMA_MASTER_KEY_B64=REPLACE_ON_SERVER
MCMA_API_TOKEN=REPLACE_ON_SERVER

# Optional internal bridge authentication
MCMA_BRIDGE_TOKEN=REPLACE_ON_SERVER

# Optional internal crypto service URL.
MCMA_CRYPTO_URL=https://example.invalid/mcma/crypto

# GitHub storage adapter
MCMA_GITHUB_TOKEN=REPLACE_ON_SERVER

# S3 / S3-compatible storage adapter
MCMA_S3_REGION=us-east-1
MCMA_S3_ACCESS_KEY_ID=REPLACE_ON_SERVER
MCMA_S3_SECRET_ACCESS_KEY=REPLACE_ON_SERVER

# Optional temporary/session credentials
# MCMA_S3_SESSION_TOKEN=REPLACE_ON_SERVER

# Optional custom S3-compatible endpoint, e.g. MinIO/R2-compatible service.
# When an endpoint is set, path-style defaults to true unless overridden.
# MCMA_S3_ENDPOINT=https://s3.example.invalid
# MCMA_S3_PATH_STYLE=true

# Standard AWS environment variable fallbacks are also recognized:
# AWS_ACCESS_KEY_ID
# AWS_SECRET_ACCESS_KEY
# AWS_SESSION_TOKEN
# AWS_REGION
# AWS_DEFAULT_REGION


# WebDAV storage adapter
# MCMA_WEBDAV_AUTH=basic
# MCMA_WEBDAV_USERNAME=REPLACE_ON_SERVER
# MCMA_WEBDAV_PASSWORD=REPLACE_ON_SERVER

# Or bearer-token authentication:
# MCMA_WEBDAV_AUTH=bearer
# MCMA_WEBDAV_TOKEN=REPLACE_ON_SERVER


# Optional semantic retrieval with Amazon Bedrock Titan Text Embeddings V2
MCMA_BEDROCK_REGION=us-east-1
MCMA_BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
MCMA_BEDROCK_DIMENSIONS=256

# Preferred current Bedrock API-key authentication:
# AWS_BEARER_TOKEN_BEDROCK=REPLACE_ON_SERVER
# or MCMA_BEDROCK_BEARER_TOKEN=REPLACE_ON_SERVER

# SigV4 authentication may use standard AWS variables or these MCMA-specific names:
# MCMA_BEDROCK_ACCESS_KEY_ID=REPLACE_ON_SERVER
# MCMA_BEDROCK_SECRET_ACCESS_KEY=REPLACE_ON_SERVER
# MCMA_BEDROCK_SESSION_TOKEN=REPLACE_ON_SERVER


# Optional generation with Amazon Bedrock Converse.
# MCMA intentionally has no hard-coded generation model.
MCMA_BEDROCK_CHAT_MODEL=REPLACE_WITH_MODEL_OR_INFERENCE_PROFILE_ID
MCMA_BEDROCK_MAX_TOKENS=1024
MCMA_BEDROCK_CHAT_TEMPERATURE=0.2
# MCMA_BEDROCK_SYSTEM_PROMPT=Answer accurately and concisely.

# The same Bedrock bearer token or SigV4 variables above are used for Converse.


# Optional local AI with Ollama.
# Keep Ollama bound to loopback unless you deliberately secure a remote endpoint.
MCMA_OLLAMA_BASE_URL=http://127.0.0.1:11434

# Set only the local capabilities you want to use.
# MCMA_OLLAMA_EMBED_MODEL=REPLACE_WITH_INSTALLED_EMBED_MODEL
# MCMA_OLLAMA_CHAT_MODEL=REPLACE_WITH_INSTALLED_CHAT_MODEL
MCMA_OLLAMA_MAX_TOKENS=1024
MCMA_OLLAMA_TEMPERATURE=0.2
# MCMA_OLLAMA_SYSTEM_PROMPT=Answer accurately and concisely.


# Optional local AI with llama.cpp.
# Recommended: separate llama-server processes for chat and embeddings.
MCMA_LLAMACPP_CHAT_URL=http://127.0.0.1:8080
MCMA_LLAMACPP_EMBED_URL=http://127.0.0.1:8081

# Use llama-server --alias values here.
# MCMA_LLAMACPP_CHAT_MODEL=mcma-chat
# MCMA_LLAMACPP_EMBED_MODEL=mcma-embed

MCMA_LLAMACPP_MAX_TOKENS=512
MCMA_LLAMACPP_TEMPERATURE=0.2
# MCMA_LLAMACPP_SYSTEM_PROMPT=Answer accurately and concisely.

# Optional E5-style prefix. Changing this changes semantic index identity.
# MCMA_LLAMACPP_EMBED_PREFIX=query: 

# Optional stable fingerprint for exact weights/tokenizer/pooling/normalization.
# MCMA_LLAMACPP_EMBED_ID=multilingual-e5-small-mean-l2-v1

# Optional llama-server API keys.
# MCMA_LLAMACPP_API_KEY=REPLACE_IF_CONFIGURED
# MCMA_LLAMACPP_CHAT_API_KEY=REPLACE_IF_CONFIGURED
# MCMA_LLAMACPP_EMBED_API_KEY=REPLACE_IF_CONFIGURED


# Google Cloud Storage
# LOCATION: gcs://BUCKET/optional/prefix
# Supply a short-lived OAuth 2.0 access token externally.
# MCMA_GCS_ACCESS_TOKEN=REPLACE_ON_SERVER

# Google Drive
# LOCATION: gdrive://ROOT_FOLDER_ID
# The adapter is intentionally single-writer because Drive does not provide
# the same atomic object CAS semantics as GCS/Azure/S3.
# MCMA_GDRIVE_ACCESS_TOKEN=REPLACE_ON_SERVER

# Microsoft Azure Blob Storage
# LOCATION: azure://ACCOUNT/CONTAINER/optional/prefix
# Prefer SAS scoped to the target container or a short-lived bearer token.
# MCMA_AZURE_SAS_TOKEN=REPLACE_ON_SERVER
# MCMA_AZURE_BEARER_TOKEN=REPLACE_ON_SERVER
# MCMA_AZURE_BLOB_ENDPOINT=https://ACCOUNT.blob.core.windows.net

# Alibaba Cloud OSS via its S3-compatible API
# LOCATION: oss://BUCKET/optional/prefix?region=cn-hangzhou
MCMA_OSS_REGION=cn-hangzhou
# MCMA_OSS_ENDPOINT=https://s3.oss-cn-hangzhou.aliyuncs.com
# MCMA_OSS_ACCESS_KEY_ID=REPLACE_ON_SERVER
# MCMA_OSS_ACCESS_KEY_SECRET=REPLACE_ON_SERVER
# MCMA_OSS_SECURITY_TOKEN=REPLACE_IF_TEMPORARY
# Standard Alibaba variables are also recognized:
# ALIBABA_CLOUD_ACCESS_KEY_ID
# ALIBABA_CLOUD_ACCESS_KEY_SECRET
# ALIBABA_CLOUD_SECURITY_TOKEN


# Multi-user web/application mode
# IMPORTANT: multi-user mode requires per-library KeyStore keys.
# Leave MCMA_MASTER_KEY_B64 UNSET when using MultiUserService.
# Use a persistent protected key directory instead:
# MCMA_KEY_DIR=/secure/path/mcma/keys

# Persistent server-side secret used only to derive non-PII stable user IDs.
# Use at least 32 random bytes/characters and back it up securely.
# Never expose this value to browsers or commit it.
# MCMA_MULTIUSER_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_BYTES

# The web authentication layer supplies a verified issuer + subject to MCMA.
# CLI administration can read them from environment variables:
# MCMA_AUTH_ISSUER=https://your-identity-provider.example
# MCMA_AUTH_SUBJECT=provider-stable-subject

# Multi-user storage layout is virtual and works on every StorageAdapter:
# system/user-registry/...
# memories/usr_<hmac-sha256>/...


# Web application
# Root storage used by the multi-user web app.
# Example: local path, s3://..., gcs://..., azure://..., oss://..., github://..., gdrive://..., webdav+https://...
# MCMA_WEB_STORAGE_LOCATION=/var/lib/mcma

# Public HTTPS origin only, without path.
# MCMA_WEB_PUBLIC_ORIGIN=https://memory.example.com

# At least 32 bytes. Used to encrypt OIDC state and web session cookies.
# MCMA_WEB_SESSION_SECRET=REPLACE_WITH_32_PLUS_RANDOM_BYTES

# Generic OpenID Connect Authorization Code + PKCE configuration.
# Current built-in ID-token validation profile accepts RS256 signed tokens.
# MCMA_OIDC_ISSUER=https://idp.example.com
# MCMA_OIDC_CLIENT_ID=mcma-web
# MCMA_OIDC_CLIENT_SECRET=REPLACE_IF_CONFIDENTIAL_CLIENT
MCMA_OIDC_SCOPE=openid

# User provisioning policy.
MCMA_WEB_AUTO_REGISTER=false
MCMA_WEB_SELF_REGISTER=false
MCMA_WEB_SESSION_TTL=28800

# Server-selected AI providers. The browser cannot override these.
MCMA_WEB_EMBEDDING_PROVIDER=none
MCMA_WEB_GENERATION_PROVIDER=none
# Alternatives:
# MCMA_WEB_EMBEDDING_PROVIDER=bedrock-titan-v2
# MCMA_WEB_EMBEDDING_PROVIDER=ollama
# MCMA_WEB_EMBEDDING_PROVIDER=llamacpp
# MCMA_WEB_GENERATION_PROVIDER=bedrock-converse
# MCMA_WEB_GENERATION_PROVIDER=ollama
# MCMA_WEB_GENERATION_PROVIDER=llamacpp
# MCMA_WEB_EMBEDDING_DIMENSIONS=256

MCMA_WEB_MIN_CONFIDENCE=0.75
MCMA_WEB_MIN_SIMILARITY=0.78
MCMA_WEB_TOP_K=5
MCMA_WEB_CAPTURE_CONFIDENCE=0.5
MCMA_WEB_CAPTURE_VALIDATION=unverified
MCMA_WEB_CAPTURE_FRESHNESS=stable
MCMA_WEB_CAPTURE_MAX_AGE=2592000
MCMA_WEB_CAPTURE_REUSE=reuse-unless-stale


# Metering / credits / billing
# Keep false until pricing and initial credits are configured.
MCMA_BILLING_ENABLED=false

# HMAC secret for external API keys. Required to create/use mcma_api_* tokens.
# MCMA_API_KEY_PEPPER=REPLACE_WITH_32_PLUS_RANDOM_BYTES

# Initial SuperAdmin OIDC identity. Only its HMAC fingerprint is persisted.
# MCMA_SUPERADMIN_ISSUER=https://your-identity-provider.example
# MCMA_SUPERADMIN_SUBJECT=provider-stable-admin-subject

# Conservative maximum output tokens used for credit reservation.
# MCMA_WEB_BILLING_MAX_OUTPUT_TOKENS=1024


# Stripe Checkout + verified webhook (optional)
# Server-side Stripe key. Prefer a restricted live key with only the permissions
# required by this integration when your Stripe account supports it.
# MCMA_STRIPE_SECRET_KEY=sk_test_REPLACE_ON_SERVER

# Webhook endpoint secret for:
# https://YOUR_MCMA_HOST/mcma/v1/billing/stripe/webhook
# MCMA_STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ON_SERVER

# Immutable/versioned package IDs are recommended. billing_mode accepts:
# payment       -> one-time Checkout; credits/plan are applied from Checkout webhook.
# subscription  -> recurring Checkout; credits are granted on each invoice.paid renewal.
# amount_minor must match the configured Stripe Price. minor_unit_exponent is
# normally 2 for USD/MXN. A package may grant credits, change plan, or both.
# MCMA_STRIPE_PACKAGES_JSON={"starter-once-2026":{"label":"Starter credits","billing_mode":"payment","price_id":"price_REPLACE","plan_id":"starter","credit_units":100000,"currency":"usd","amount_minor":1000,"minor_unit_exponent":2},"pro-monthly-2026":{"label":"Pro monthly","billing_mode":"subscription","price_id":"price_REPLACE_RECURRING","plan_id":"pro","credit_units":500000,"currency":"usd","amount_minor":3000,"minor_unit_exponent":2}}
