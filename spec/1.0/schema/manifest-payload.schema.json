{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mcma-openmemory.example/spec/1.0/schema/manifest-payload.schema.json",
  "title": "MCMA 1.0 Manifest Payload",
  "type": "object",
  "required": [
    "library_version",
    "created_at",
    "metadata_mode",
    "root_index",
    "entrypoints",
    "crypto_policy",
    "extensions"
  ],
  "additionalProperties": false,
  "properties": {
    "library_version": { "const": "1.0" },
    "created_at": { "type": "string", "format": "date-time" },
    "metadata_mode": { "enum": ["normal", "private"] },
    "root_index": {
      "type": "object",
      "required": ["object_id", "storage_hash"],
      "additionalProperties": false,
      "properties": {
        "object_id": {
          "type": "string",
          "pattern": "^obj_[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "storage_hash": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "entrypoints": {
      "type": "object",
      "required": ["profile", "permissions", "vault"],
      "additionalProperties": true,
      "properties": {
        "profile": { "const": "memory://identity/profile" },
        "permissions": { "const": "memory://access/permissions" },
        "vault": { "const": "memory://access/vault" }
      }
    },
    "crypto_policy": {
      "type": "object",
      "required": ["active_key_version"],
      "additionalProperties": true,
      "properties": {
        "active_key_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        }
      }
    },
    "extensions": { "type": "object" }
  }
}
