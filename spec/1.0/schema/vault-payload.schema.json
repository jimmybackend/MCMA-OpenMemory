{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcma:spec:1.0:schema:vault-payload",
  "title": "MCMA 1.0 Encrypted Vault Payload",
  "type": "object",
  "required": ["vault_version", "entries"],
  "additionalProperties": false,
  "properties": {
    "vault_version": { "const": "1.0" },
    "entries": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
      "additionalProperties": {
        "type": "object",
        "required": ["type", "secret_b64u", "created_at", "updated_at"],
        "additionalProperties": false,
        "properties": {
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,63}$" },
          "secret_b64u": { "type": "string", "pattern": "^[A-Za-z0-9_-]*$" },
          "created_at": { "type": "string", "format": "date-time" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
