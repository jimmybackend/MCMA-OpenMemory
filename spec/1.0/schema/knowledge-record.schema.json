{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:mcma:spec:1.0:schema:knowledge-record",
  "title": "MCMA 1.0 Knowledge Record",
  "type": "object",
  "required": ["knowledge_version", "intent", "answer", "provenance", "epistemic", "freshness", "relations"],
  "additionalProperties": false,
  "properties": {
    "knowledge_version": { "const": "1.0" },
    "intent": {
      "type": "object",
      "required": ["question", "normalized", "key"],
      "additionalProperties": false,
      "properties": {
        "question": { "type": "string", "minLength": 1 },
        "normalized": { "type": "string", "minLength": 1 },
        "key": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
      }
    },
    "answer": {
      "type": "object",
      "required": ["format", "value"],
      "additionalProperties": false,
      "properties": {
        "format": { "enum": ["text", "markdown", "json"] },
        "value": {}
      },
      "allOf": [
        {
          "if": { "properties": { "format": { "enum": ["text", "markdown"] } } },
          "then": { "properties": { "value": { "type": "string" } } }
        }
      ]
    },
    "provenance": {
      "type": "array",
      "items": { "$ref": "#/$defs/provenance" }
    },
    "epistemic": {
      "type": "object",
      "required": ["confidence", "validation_state", "evidence_count", "captured_at", "last_validated_at", "history"],
      "additionalProperties": false,
      "properties": {
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "validation_state": { "$ref": "#/$defs/validationState" },
        "evidence_count": { "type": "integer", "minimum": 0 },
        "captured_at": { "type": "string", "format": "date-time" },
        "last_validated_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        },
        "history": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["at", "validation_state", "confidence", "reason"],
            "additionalProperties": false,
            "properties": {
              "at": { "type": "string", "format": "date-time" },
              "validation_state": { "$ref": "#/$defs/validationState" },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "reason": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "freshness": {
      "type": "object",
      "required": ["class", "max_age_seconds", "reuse_policy"],
      "additionalProperties": false,
      "properties": {
        "class": { "enum": ["immutable", "stable", "dynamic", "volatile"] },
        "max_age_seconds": {
          "oneOf": [
            { "type": "integer", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "reuse_policy": { "enum": ["always", "reuse-unless-stale", "revalidate-if-stale", "never-direct"] }
      }
    },
    "relations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^memory://[a-z][a-z0-9-]{0,31}(?:/[a-z0-9][a-z0-9._-]{0,127})+$"
      }
    }
  },
  "$defs": {
    "validationState": {
      "enum": ["unverified", "plausible", "supported", "verified", "disputed", "retracted"]
    },
    "provenance": {
      "type": "object",
      "required": ["source_type", "reference", "captured_at"],
      "additionalProperties": false,
      "properties": {
        "source_type": {
          "enum": ["user", "memory", "web", "documentation", "api", "database", "working-test", "model", "file", "observation", "migration", "other"]
        },
        "reference": { "type": "string", "minLength": 1, "maxLength": 2048 },
        "captured_at": { "type": "string", "format": "date-time" },
        "content_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "note": { "type": "string", "maxLength": 1024 }
      }
    }
  }
}
