}

function parseOptions(array $args): array
{
    $out=[];
    foreach($args as $arg){
        if(!str_starts_with($arg,'--')||!str_contains($arg,'=')) fail('Invalid option: '.$arg,2);
        [$name,$value]=explode('=',substr($arg,2),2);
        $out[$name]=$value;
    }
    return $out;
}
function pretty(mixed $value): string { return json_encode($value,JSON_PRETTY_PRINT|JSON_UNESCAPED_SLASHES|JSON_UNESCAPED_UNICODE|JSON_THROW_ON_ERROR); }
function storage(string $location) { return StorageFactory::fromLocation($location); }
function library(string $location): Library { return Library::open(storage($location)); }
function actor(array $opts): string { return $opts['actor'] ?? 'owner'; }
function readInput(string $input,string $format): mixed
{
    $bytes=$input==='-'?stream_get_contents(STDIN):@file_get_contents($input);
    if($bytes===false) fail('Unable to read input: '.$input);
    if($format==='json'){
        try{return json_decode($bytes,true,512,JSON_THROW_ON_ERROR);}
        catch(Throwable $e){fail('Input is not valid JSON: '.$e->getMessage());}
    }
    return $bytes;
}
function readJsonValue(string $path): mixed
{
    $bytes=@file_get_contents($path);
    if($bytes===false) fail('Unable to read JSON file: '.$path);
    try{return json_decode($bytes,true,512,JSON_THROW_ON_ERROR);}
    catch(Throwable $e){fail('Invalid JSON file: '.$e->getMessage());}
}
function readJsonObject(string $path): array
{
    $value=readJsonValue($path);
    if(!is_array($value)||array_is_list($value)) fail('JSON file must contain an object');
    return $value;
}
function readJsonArray(string $path): array
{
    $value=readJsonValue($path);
    if(!is_array($value)||!array_is_list($value)) fail('JSON file must contain an array');
    return $value;
}
function readTextFile(string $path): string
{
    $bytes=@file_get_contents($path);
    if($bytes===false) fail('Unable to read text file: '.$path);
    $value=trim($bytes);
    if($value==='') fail('Text file must not be empty: '.$path);
    return $value;
}
function yesNo(array $opts,string $name,bool $default=false): bool
{
    if(!array_key_exists($name,$opts)) return $default;
    $value=strtolower(trim((string)$opts[$name]));
    if(in_array($value,['yes','true','1','on'],true)) return true;
    if(in_array($value,['no','false','0','off'],true)) return false;
    fail('Invalid boolean option --'.$name.'='.$opts[$name]);
}
function envSecret(string $name): string
{
    if(!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/',$name)) fail('Invalid environment variable name');
    $value=getenv($name);
    if(!is_string($value)) fail('Secret environment variable is not set: '.$name);
    return $value;
}
function recoveryPassphrase(array $opts): string
{
    $name=$opts['passphrase-env']??'MCMA_RECOVERY_PASSPHRASE';
    return envSecret($name);
}
function renderTree(array $tree,string $prefix=''): string
{
    $lines=[];$keys=array_values(array_filter(array_keys($tree),static fn(string $k):bool=>$k!=='@object_id'));sort($keys,SORT_STRING);
    foreach($keys as $i=>$key){
        $last=$i===count($keys)-1;$lines[]=$prefix.($last?'└── ':'├── ').$key;$child=$tree[$key];
        if(is_array($child)){
            $cp=$prefix.($last?'    ':'│   ');
            if(isset($child['@object_id']))$lines[]=$cp.'└── '.$child['@object_id'];
            $nested=renderTree($child,$cp);if($nested!=='')$lines[]=$nested;
        }
    }
    return implode(PHP_EOL,$lines);
}

try {
    $args=$argv;array_shift($args);$command=array_shift($args)??null;
    if($command===null||in_array($command,['help','-h','--help'],true)) usage();

    switch($command){
        case 'init': {
            $loc=array_shift($args)??usage();$opts=parseOptions($args);
            $lib=Library::init(storage($loc),$opts['mode']??'private');$info=$lib->info();
            echo "Initialized MCMA 1.0 library\n".pretty($info).PHP_EOL;
            if(getenv('MCMA_MASTER_KEY_B64')===false||trim((string)getenv('MCMA_MASTER_KEY_B64'))==='') echo 'Local key: '.KeyStore::keyPath($info['library_id']).PHP_EOL;
            break;
        }
        case 'open': {
            $loc=array_shift($args)??usage();if($args!==[])usage();$v=library($loc)->verify();
            echo 'Opened '.$v['library_id'].' on '.$v['storage'].PHP_EOL.'Verified indexed objects: '.$v['objects_verified'].PHP_EOL;break;
        }
        case 'info': {
            $loc=array_shift($args)??usage();if($args!==[])usage();echo pretty(library($loc)->info()).PHP_EOL;break;
        }
        case 'write': {
            $loc=array_shift($args)??usage();$uri=array_shift($args)??usage();$input=array_shift($args)??usage();$opts=parseOptions($args);
            $format=$opts['format']??'text';
            echo pretty(library($loc)->writeAs(actor($opts),$uri,readInput($input,$format),$format,$opts['temperature']??'hot',$opts['layer']??'40-semantic',$opts['scope']??'user',$opts['maturity']??'raw')).PHP_EOL;break;
        }
        case 'update': {
            $loc=array_shift($args)??usage();$uri=array_shift($args)??usage();$input=array_shift($args)??usage();$opts=parseOptions($args);
            $lib=library($loc);$current=$lib->readAs(actor($opts),$uri);$format=$opts['format']??(string)($current['payload']['content_format']??'text');
            echo pretty($lib->updateAs(actor($opts),$uri,readInput($input,$format),$opts['format']??null,$opts['temperature']??null,$opts['layer']??null,$opts['scope']??null,$opts['maturity']??null)).PHP_EOL;break;
        }
        case 'temperature': {
            $loc=array_shift($args)??usage();$uri=array_shift($args)??usage();$temp=array_shift($args)??usage();$opts=parseOptions($args);
            echo pretty(library($loc)->setTemperatureAs(actor($opts),$uri,strtolower($temp))).PHP_EOL;break;
        }
        case 'read': {
            $loc=array_shift($args)??usage();$uri=array_shift($args)??usage();$opts=parseOptions($args);
            $p=library($loc)->readAs(actor($opts),$uri)['payload'];$f=$p['content_format']??'json';$content=$p['content']??null;
            if($f==='binary'&&is_string($content))fwrite(STDOUT,Crypto::b64uDecode($content));
            elseif($f==='json')echo pretty($content).PHP_EOL;
            elseif(is_string($content)){echo $content;if(!str_ends_with($content,"\n"))echo PHP_EOL;}
            else echo pretty($content).PHP_EOL;
            break;
        }
        case 'verify': {
            $loc=array_shift($args)??usage();if($args!==[])usage();echo pretty(library($loc)->verify()).PHP_EOL;break;
        }
        case 'list': {
            $loc=array_shift($args)??usage();$opts=parseOptions($args);
            foreach(library($loc)->listAs(actor($opts)) as $entry) echo ($entry['logical_refs'][0]??'(no-ref)')."\t".$entry['object_id']."\t".($entry['temperature']??'').PHP_EOL;
            break;
        }
        case 'tree': {
            $loc=array_shift($args)??usage();$opts=parseOptions($args);echo "memory://\n";$rendered=renderTree(library($loc)->treeAs(actor($opts)));if($rendered!=='')echo $rendered.PHP_EOL;break;
        }

        case 'access-init': {
            $loc=array_shift($args)??usage();$opts=parseOptions($args);$policy=isset($opts['policy'])?readJsonObject($opts['policy']):null;
            echo pretty(library($loc)->initializeAccessControl($policy,actor($opts))).PHP_EOL;break;
        }
        case 'access-check': {
            $loc=array_shift($args)??usage();$who=array_shift($args)??usage();$action=array_shift($args)??usage();$resource=array_shift($args)??usage();if($args!==[])usage();
            echo pretty(library($loc)->permissionDecision($who,$action,$resource)).PHP_EOL;break;
        }
        case 'permissions-show': {
            $loc=array_shift($args)??usage();$opts=parseOptions($args);echo pretty(library($loc)->permissions(actor($opts))).PHP_EOL;break;
        }
        case 'permissions-set': {
            $loc=array_shift($args)??usage();$file=array_shift($args)??usage();$opts=parseOptions($args);
            echo pretty(library($loc)->setPermissions(readJsonObject($file),actor($opts))).PHP_EOL;break;
        }
        case 'vault-put': {
            $loc=array_shift($args)??usage();$name=array_shift($args)??usage();$env=array_shift($args)??usage();$opts=parseOptions($args);
            $secret=envSecret($env);
            try{echo pretty(library($loc)->vaultPut($name,$secret,$opts['type']??'secret',actor($opts))).PHP_EOL;}
            finally{$secret=str_repeat("\0",strlen($secret));}
            break;
        }
        case 'vault-list': {
            $loc=array_shift($args)??usage();$opts=parseOptions($args);echo pretty(library($loc)->vaultList(actor($opts))).PHP_EOL;break;
        }
        case 'vault-delete': {
            $loc=array_shift($args)??usage();$name=array_shift($args)??usage();$opts=parseOptions($args);echo pretty(library($loc)->vaultDelete($name,actor($opts))).PHP_EOL;break;
        }

        case 'knowledge-put': {
            $loc=array_shift($args)??usage();$questionFile=array_shift($args)??usage();$answerFile=array_shift($args)??usage();$opts=parseOptions($args);
            $question=readTextFile($questionFile);$format=$opts['answer-format']??'text';
            $answer=$format==='json'?readJsonValue($answerFile):readInput($answerFile,$format);
            $provenance=isset($opts['provenance'])?readJsonArray($opts['provenance']):[];
            $freshness=$opts['freshness']??'stable';
            $maxAge=$freshness==='immutable'?null:(isset($opts['max-age'])?(int)$opts['max-age']:2592000);
            $service=new KnowledgeService(library($loc));
            echo pretty($service->capture(actor($opts),$question,$answer,$format,(float)($opts['confidence']??0.5),$opts['validation']??'unverified',$provenance,$freshness,$maxAge,$opts['reuse']??'reuse-unless-stale')).PHP_EOL;
            break;
        }
        case 'knowledge-check': {
            $loc=array_shift($args)??usage();$questionFile=array_shift($args)??usage();$opts=parseOptions($args);
            $service=new KnowledgeService(library($loc));
            echo pretty($service->directAnswer(actor($opts),readTextFile($questionFile),yesNo($opts,'current',false),(float)($opts['min-confidence']??0.75))).PHP_EOL;
            break;
        }
        case 'knowledge-show': {
            $loc=array_shift($args)??usage();$questionFile=array_shift($args)??usage();$opts=parseOptions($args);
            echo pretty((new KnowledgeService(library($loc)))->inspect(actor($opts),readTextFile($questionFile))).PHP_EOL;
            break;
        }
        case 'knowledge-validate': {
            $loc=array_shift($args)??usage();$questionFile=array_shift($args)??usage();$state=array_shift($args)??usage();$confidence=array_shift($args)??usage();$reasonFile=array_shift($args)??usage();$opts=parseOptions($args);
            $provenance=isset($opts['provenance'])?readJsonArray($opts['provenance']):[];
            echo pretty((new KnowledgeService(library($loc)))->validateKnowledge(actor($opts),readTextFile($questionFile),$state,(float)$confidence,readTextFile($reasonFile),$provenance)).PHP_EOL;
            break;
        }

        case 'key-export': {
            $loc=array_shift($args)??usage();$out=array_shift($args)??usage();$opts=parseOptions($args);$lib=library($loc);
            echo pretty(KeyStore::exportRecovery($lib->libraryId(),$out,recoveryPassphrase($opts))).PHP_EOL;break;
        }
        case 'key-import': {
            $in=array_shift($args)??usage();$opts=parseOptions($args);echo pretty(KeyStore::importRecovery($in,recoveryPassphrase($opts),($opts['replace']??'no')==='yes')).PHP_EOL;break;
        }
        case 'migrate': {
            $loc=array_shift($args)??usage();$source=array_shift($args)??usage();$uri=array_shift($args)??usage();$opts=parseOptions($args);
            $legacyEnv=$opts['legacy-key-env']??'MCMA_LEGACY_MASTER_KEY_B64';if(!preg_match('/^[A-Za-z_][A-Za-z0-9_]*$/',$legacyEnv))fail('Invalid legacy-key environment variable name');
            $h=HistoricalCrypto::readAndDecrypt($source,HistoricalCrypto::loadLegacyMasterKey($opts['legacy-key-file']??null,$legacyEnv));$format=$opts['format']??'text';$content=$h['plaintext'];
            if($format==='json')$content=json_decode($content,true,512,JSON_THROW_ON_ERROR);
            echo pretty(library($loc)->importHistorical($uri,$content,$h['envelope'],$format,$opts['temperature']??'cold',$opts['layer']??'40-semantic',$opts['scope']??'user',$opts['maturity']??'observed',$opts['source-ref']??basename($source))).PHP_EOL;break;
        }
        case 'storage-copy': {
            $source=array_shift($args)??usage();$dest=array_shift($args)??usage();if($args!==[])usage();echo pretty(StorageMigrator::copy(storage($source),storage($dest))).PHP_EOL;break;
        }
        default: usage();
    }
} catch(Throwable $e) { fail($e->getMessage()); }
